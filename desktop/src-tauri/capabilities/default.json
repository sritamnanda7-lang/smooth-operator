{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Settings window (main): an allow-list. Only commands the visible panes use. Never grants start/stop_handy_keys_recording or change_autostart_setting.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:event:allow-listen",
    "core:event:allow-unlisten",
    "core:app:allow-version",
    "os:allow-locale",
    "process:allow-restart",
    "allow-get-app-settings",
    "allow-get-default-settings",
    "allow-initialize-enigo",
    "allow-initialize-shortcuts",
    "allow-complete-onboarding",
    "allow-show-main-window-command",
    "allow-get-secure-input-status",
    "allow-get-active-notices",
    "allow-dismiss-notice",
    "allow-get-available-models",
    "allow-download-model",
    "allow-download-language-detector",
    "allow-is-language-detector-downloaded",
    "allow-delete-model",
    "allow-get-retired-models",
    "allow-delete-retired-model",
    "allow-cancel-download",
    "allow-set-active-model",
    "allow-get-current-model",
    "allow-rescan-local-models",
    "allow-update-microphone-mode",
    "allow-get-windows-microphone-permission-status",
    "allow-open-microphone-privacy-settings",
    "allow-get-available-microphones",
    "allow-set-selected-microphone",
    "allow-get-available-output-devices",
    "allow-play-test-sound",
    "allow-check-custom-sounds",
    "allow-set-clamshell-microphone",
    "allow-is-laptop",
    "allow-get-language-status",
    "allow-change-theme-setting",
    "allow-change-app-language-setting",
    "allow-change-sound-theme-setting",
    "allow-change-word-correction-threshold-setting",
    "allow-change-paste-delay-ms-setting",
    "allow-change-paste-delay-after-ms-setting",
    "allow-change-reliable-paste-setting",
    "allow-change-hold-threshold-ms-setting",
    "allow-change-extra-recording-buffer-setting",
    "allow-change-language-detection-window-setting",
    "allow-change-chinese-script-setting",
    "allow-change-translate-to-english-setting",
    "allow-change-selected-language-setting",
    "allow-change-spoken-languages-setting",
    "allow-change-debug-mode-setting",
    "allow-set-log-level",
    "allow-get-app-dir-path",
    "allow-open-app-data-dir",
    "allow-get-log-dir-path",
    "allow-open-log-dir",
    "allow-run-keyboard-diagnostic",
    "allow-so-get-hotkey",
    "allow-so-set-hotkey",
    "allow-so-hotkey-options",
    "allow-so-fn-check",
    "macos-permissions:allow-check-accessibility-permission",
    "macos-permissions:allow-request-accessibility-permission",
    "macos-permissions:allow-check-microphone-permission",
    "macos-permissions:allow-request-microphone-permission",
    "allow-get-transcription-model-status",
    "allow-is-recording",
    "allow-get-available-accelerators"
  ]
}
