{
  "name": "smooth-operator-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write . && cd src-tauri && cargo fmt",
    "format:check": "prettier --check . && cd src-tauri && cargo fmt -- --check",
    "format:frontend": "prettier --write .",
    "format:backend": "cd src-tauri && cargo fmt",
    "test:keyboard": "bun src/lib/utils/keyboard.test.ts",
    "test:playwright": "playwright test",
    "test:playwright:ui": "playwright test --ui",
    "check:translations": "bun scripts/check-translations.ts",
    "check:model-languages": "bun scripts/check-model-language-coverage.ts",
    "sync:catalog": "bun scripts/sync-catalog.ts",
    "check:catalog": "bun scripts/sync-catalog.ts --check",
    "build:cjk-font": "bun scripts/build-cjk-font.ts",
    "check:cjk-font": "bun scripts/build-cjk-font.ts --check"
  },
  "dependencies": {
    "@handy-computer/models": "0.2.3",
    "@tailwindcss/vite": "^4.3.4",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-os": "~2.3.2",
    "@tauri-apps/plugin-process": "~2.3.1",
    "i18next": "^25.7.2",
    "immer": "^11.1.3",
    "lucide-react": "^0.542.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^16.4.1",
    "react-select": "^5.8.0",
    "tailwindcss": "^4.1.16",
    "tauri-plugin-macos-permissions-api": "2.3.0",
    "zustand": "^5.0.8"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@tauri-apps/cli": "^2.11.0",
    "@types/node": "^24.9.1",
    "@types/react": "^18.3.26",
    "@types/react-dom": "^18.3.7",
    "@types/react-select": "^5.0.1",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^9.39.1",
    "eslint-plugin-i18next": "^6.1.3",
    "prettier": "^3.6.2",
    "subset-font": "2.3.0",
    "typescript": "~5.6.3",
    "vite": "^6.4.5"
  }
}
