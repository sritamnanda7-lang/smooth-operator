{
  "manifest_version": 3,
  "name": "Smooth Operator",
  "version": "0.1.0",
  "description": "Connects Chrome to the Smooth Operator app on this computer.",
  "minimum_chrome_version": "116",
  "key": "",
  "permissions": ["storage", "alarms", "scripting"],
  "host_permissions": ["https://www.youtube.com/*", "https://docs.google.com/*", "https://calendar.google.com/*"],
  "background": { "service_worker": "sw.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Smooth Operator" }
}
